# Server-side Gemini credential. Never use a VITE_ prefix for this value.
GEMINI_API_KEY=replace-with-a-server-side-gemini-api-key

# Express API port used by the Vite development proxy.
PORT=3001

# Comma-separated browser origins allowed to call the API.
# For local development, keep the Vite origin listed.
ALLOWED_ORIGINS=http://localhost:3000
